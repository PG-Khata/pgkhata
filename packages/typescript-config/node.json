{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["es2022"],
    "types": ["node"],
    "noEmit": true,
    /*
     * Workspace packages export raw TypeScript ("exports": "./src/index.ts")
     * and apps/api is bundled before it runs, so module resolution is a
     * bundler's, not Node's. NodeNext would demand explicit .js extensions on
     * every relative import and would resolve those package entrypoints to
     * empty modules.
     */
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    /*
     * Nothing in the backend emits .d.ts — consumers typecheck against source.
     * Leaving declaration emit on makes TS reject every inferred Express
     * `Router` as "not portable" because the type lives in a pnpm-hoisted
     * @types/express-serve-static-core path.
     */
    "declaration": false,
    "declarationMap": false
  }
}
